{
  "expo": {
    "name": "NodeOne",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.comenzistoc.dqckyf"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0A0E1F"
      },
      "package": "com.emergent.comenzistoc.dqckyf"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#0A0E1F"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "expo-sharing",
      [
        "expo-camera",
        { "cameraPermission": "Scaneaza codul de bare al produselor" }
      ],
      [
        "expo-image-picker",
        { "photosPermission": "Alege o poza de profil din galerie" }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
